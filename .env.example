# Everything is optional: the app runs on built-in demo data with no setup.
#
# Set these in production (e.g. Vercel → Settings → Environment Variables) so nobody
# who knows the built-in demo defaults can forge sessions or QR codes.
# Generate each with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"

# Signs the login cookie.
SESSION_SECRET=""
# Signs the rotating QR codes. Changing it invalidates every QR currently on screen.
TICKET_SIGNING_SECRET=""
